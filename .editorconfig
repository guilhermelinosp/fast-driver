# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{dart,yaml,yml}]
indent_size = 2
quote_type = single

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{json,lock}]
indent_size = 2

[*.{swift,m,h}]
indent_size = 4