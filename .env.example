# ==============================================================================
# Fast Driver — configuration (copy to .env and fill in ALL values)
# ==============================================================================
# cp .env.example .env
#
# Injected at compile time:
#   flutter run --dart-define-from-file=.env
#   flutter build ios --dart-define-from-file=.env
#
# All values are REQUIRED — the app will not start without them.
# See lib/accept_ride_service.dart (ApiConfig) for details.
# ==============================================================================

# Backend drive/ride API base URL (accept endpoint lives under /api/v1/drives)
API_BASE_URL=